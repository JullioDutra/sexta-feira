# ===========================================================================
#  Sexta-Feira — configuração
#  Copie este arquivo para ".env" (o instalador já faz isso) e ajuste.
# ===========================================================================

# --- Cérebro ---------------------------------------------------------------
# claude = na nuvem (bem mais rápido e inteligente; pago por uso, precisa de internet)
# ollama = no seu PC (gratuito e offline; depende de uma boa placa de vídeo)
# auto   = Claude se houver ANTHROPIC_API_KEY, senão Ollama
CEREBRO=auto
# Chave da API do Claude: crie em https://console.anthropic.com (menu API Keys)
ANTHROPIC_API_KEY=
# Principal (conversa, análise, planejamento) e rápido (comandos curtos). Vazio no rápido = um só.
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_MODELO_RAPIDO=claude-haiku-5-5
# Quanto ela "pensa" antes de responder: low | medium | high. Na voz, low é o mais ágil.
CLAUDE_ESFORCO_VOZ=low
CLAUDE_ESFORCO_TEXTO=medium

# --- Cérebro local (Ollama, roda no seu PC) --------------------------------
OLLAMA_URL=http://127.0.0.1:11434
# Modelo com suporte a ferramentas. Sugestões:
#   qwen3.5:9b  -> placa de vídeo com 8 GB+ (padrão, bom em português)
#   qwen3.5:4b  -> PCs mais simples / 4-6 GB de vídeo
#   qwen3.6:27b -> placas com 24 GB
OLLAMA_MODELO=qwen3.5:9b
# "Dois cérebros" (opcional): um modelo pequeno e rápido para comandos curtos
# ("fecha o Chrome e abre o Spotify"); o principal fica com conversa, planejamento e análise.
# Ex.: OLLAMA_MODELO_RAPIDO=qwen3.5:4b  (rode: ollama pull qwen3.5:4b)
OLLAMA_MODELO_RAPIDO=
# Modelo com visão para "Sexta, analisa a tela" e "o que é isso?" (câmera).
# Vazio = usa o OLLAMA_MODELO (o qwen3.5 já enxerga imagens).
OLLAMA_MODELO_VISAO=
# "pensar" deixa as respostas mais lentas; para voz, deixe desligado
OLLAMA_PENSAR=nao
OLLAMA_CONTEXTO=8192
OLLAMA_TEMPERATURA=0.5
# Quanto tempo o modelo fica carregado sem uso. Recarregar leva vários segundos,
# então um valor alto deixa a primeira resposta do dia mais rápida (-1 = sempre).
OLLAMA_MANTER_CARREGADO=4h
# Limite de tamanho das respostas faladas (tokens)
OLLAMA_MAX_TOKENS_VOZ=400

# --- Arquivos --------------------------------------------------------------
# A busca já cobre Área de Trabalho, Documentos, Downloads, Imagens, Músicas, Vídeos e OneDrive.
# Pastas extras, separadas por vírgula (ex.: D:\Projetos, E:\Faculdade)
PASTAS_ARQUIVOS=

# --- Notificações no celular (opcional) -----------------------------------
# Para receber avisos dos protocolos mesmo com o celular bloqueado: instale o app
# gratuito "ntfy", assine um tópico com nome difícil de adivinhar e coloque o mesmo nome aqui.
# O texto da notificação passa pelo servidor do ntfy (ou pelo seu, em NTFY_SERVIDOR).
NTFY_TOPICO=
NTFY_SERVIDOR=https://ntfy.sh

# --- Servidor --------------------------------------------------------------
PORTA=8765
# Acesso pelo celular (HTTPS na rede de casa)
LIBERAR_CELULAR=sim
PORTA_CELULAR=8766
# Endereço do Tailscale para usar fora de casa (ver README), ex.:
# ENDERECO_EXTERNO=https://meu-pc.tail1234.ts.net
ENDERECO_EXTERNO=
# Abrir o HUD automaticamente ao iniciar (edge = janela de app do Edge; padrao = navegador padrão)
ABRIR_HUD=sim
NAVEGADOR=edge

# --- Voz -------------------------------------------------------------------
# vosk (offline, padrão) | porcupine (precisa de chave) | nenhum (só botão)
ATIVACAO_MOTOR=vosk
ATIVACAO_FRASES=sexta feira
# Porcupine (opcional): crie a palavra "Sexta-Feira" em português em console.picovoice.ai
PORCUPINE_CHAVE=
PORCUPINE_ARQUIVO=
PORCUPINE_MODELO=

# Transcrição: tiny | base | small (padrão) | medium | large-v3-turbo (precisa de GPU NVIDIA)
WHISPER_MODELO=small
# auto (usa a GPU NVIDIA se der) | cpu | cuda
WHISPER_DISPOSITIVO=auto

# Motor de voz: edge (voz neural da Microsoft, precisa de internet; o texto da resposta é enviado
# ao serviço de voz da Microsoft) | windows (100% offline, usa as vozes instaladas no Windows)
VOZ_MOTOR=edge
# Voz da Sexta (edge-tts). Femininas: pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural
# Masculina: pt-BR-AntonioNeural
VOZ=pt-BR-FranciscaNeural
VOZ_VELOCIDADE=+8%
VOZ_TOM=+0Hz

# Microfone / alto-falante: vazio = padrão do Windows. Liste com: python -m sexta microfones
MICROFONE=
ALTO_FALANTE=
# Silêncio (ms) que indica que você terminou de falar
FIM_DE_FALA_MS=850
# Dizer "Sexta-Feira" enquanto ela fala interrompe a resposta
INTERROMPER_COM_ATIVACAO=sim

# --- Câmera ----------------------------------------------------------------
CAMERA_INDICE=0
CAMERA_LARGURA=640
CAMERA_ALTURA=480
# dshow (mais rápido no Windows) | msmf | auto
CAMERA_BACKEND=dshow

# --- Outros ----------------------------------------------------------------
LOG_NIVEL=INFO
